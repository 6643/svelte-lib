{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "lib": ["DOM", "ESNext"],
        "types": ["bun", "node", "svelte"]
    },
    "include": ["src/**/*.svelte", "*.ts"]
}
